PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/watchr

# JWT + Cookie secrets — use different long random strings for each
JWT_SECRET=replace_with_long_random_string_32_chars_min
COOKIE_SECRET=replace_with_different_long_random_string

# TMDB — from https://www.themoviedb.org/settings/api
# Use the "API Read Access Token" (Bearer token, not the API key)
TMDB_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiJ9...

# Groq — from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Frontend origin
CLIENT_URL=https://watchrbynhloso.vercel.app
